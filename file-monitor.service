[Unit]
Description=Gate controller image and command daemon
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gate-controller
Group=gate-controller
SupplementaryGroups=gpio
WorkingDirectory=/opt/gate-controller-deploy/current
EnvironmentFile=/etc/gate-controller.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/gate-controller-deploy/current/.venv/bin/python -c 'import sys; assert sys.version_info >= (3, 10), "gate-controller requires Python 3.10+"'
ExecStartPre=/opt/gate-controller-deploy/current/.venv/bin/python -m gate_controller.relay_safe
ExecStart=/opt/gate-controller-deploy/current/.venv/bin/python -m gate_controller
ExecStopPost=/opt/gate-controller-deploy/current/.venv/bin/python -m gate_controller.relay_safe
Restart=always
RestartSec=5s
TimeoutStopSec=15s
MemoryMax=512M
UMask=0077
StateDirectory=gate-controller
StateDirectoryMode=0710
ReadWritePaths=/var/lib/gate-controller
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/gate-controller-deploy

[Install]
WantedBy=multi-user.target
