# Required for local recognition.
PLATE_RECOGNIZER_API_TOKEN=
GATE_WATCH_DIRECTORY=/var/lib/gate-controller/uploads
GATE_AUTHORISED_PLATES=/var/lib/gate-controller/authorised_licence_plates.csv
GATE_DATABASE=/var/lib/gate-controller/gate-controller.db
GATE_MAX_IMAGE_AGE_SECONDS=8
GATE_DECISION_TIMEOUT_SECONDS=6
GATE_MAX_BURST_CANDIDATES=8
GATE_MAX_CANDIDATE_IMAGE_BYTES=8388608
# Continuously decode the loopback MediaMTX fluent path into a bounded frame ring.
GATE_HOT_STREAM_ENABLED=false
GATE_HOT_STREAM_SAMPLE_FPS=5
GATE_HOT_STREAM_FRAME_COUNT=8
GATE_HOT_STREAM_SELECTION_COUNT=1
GATE_HOT_STREAM_MAX_AGE_SECONDS=1
GATE_HOT_STREAM_MAX_FRAME_BYTES=8388608
GATE_HOT_STREAM_MAX_TOTAL_BYTES=50331648
# Optional authenticated camera-event provenance. A secret enables the listener.
# Use a random 20-128 character value and restrict TCP/8766 to the camera LAN.
GATE_REOLINK_WEBHOOK_SECRET=
GATE_REOLINK_WEBHOOK_HOST=0.0.0.0
GATE_REOLINK_WEBHOOK_PORT=8766
# Grab one clear-stream frame per accepted webhook event and recognise it before
# the FTP upload arrives. Requires the camera Clear I-frame interval at 1x.
GATE_TRIGGER_CAPTURE_ENABLED=true
GATE_TRIGGER_CAPTURE_SOURCE=rtsp://127.0.0.1:8554/clear
GATE_TRIGGER_CAPTURE_TIMEOUT_SECONDS=3
# Wait for the vehicle to stop at the gate, then grab a short series of frames.
GATE_TRIGGER_CAPTURE_DELAY_SECONDS=1.5
GATE_TRIGGER_CAPTURE_HOT_KEYFRAMES=true
GATE_TRIGGER_CAPTURE_COUNT=3
GATE_TRIGGER_CAPTURE_SPACING_SECONDS=1
GATE_TRIGGER_CAPTURE_MIN_INTERVAL_SECONDS=5
# The presence session keeps grabbing frames while the vehicle is still at the
# gate (GATE_PRESENCE_WINDOW_SECONDS, GATE_PRESENCE_SPACING_SECONDS,
# GATE_PRESENCE_MAX_FRAMES). A plate read at or above this bar with no
# authorised plate within two edits of it ends the session: another frame of
# the same car cannot change that answer and each one is a paid lookup. It is
# deliberately not the band's exact-match bar - nothing decided here can open
# the gate, it can only stop the session spending. A value outside 0.10-1 is
# clamped rather than refused, because a bad bar must not stop capture from
# starting. See docs/reolink-rlc-810a.md.
GATE_PRESENCE_CONCLUSIVE_CONFIDENCE=0.75
# 0 uploads frames as captured. Set 1920 only once the plate is >=300 px wide in 4K.
GATE_OCR_MAX_UPLOAD_WIDTH=1920
# A cloud lookup is charged whether or not the answer arrives in time. A frame
# whose remaining decision budget is below this is skipped without being sent.
# The default sits just under the measured p50 of every attempt that completed
# 3-6 September (1.07 s); re-derive it if the uplink changes.
GATE_OCR_MIN_REQUEST_SECONDS=1.0

# Plate matching confidence, per fuzziness level. The level per time-of-day
# band still comes from Gate Mate; these are the bars this site asks of a read
# at each level. See docs/plate-matching.md. Any value that is not a finite
# number in 0.10-1 is refused and that bar falls back to 0.90, the value the
# controller required before these existed - a typo never widens the gate.
# 0 and 1e-9 are refused with everything else: a bar no read can fail is not a
# bar, and 0.10 is already well below the laxest value anything here ships.
#
# An exact match is a character-for-character equality with an authorised
# plate, so a doubtful read cannot reach it by accident; the daytime bar is
# well below the overnight one on purpose.
GATE_MATCH_MIN_CONFIDENCE_STANDARD=0.75
GATE_MATCH_MIN_CONFIDENCE_STRICT=0.90
# A fuzzy match is deliberately not the authorised plate, so it is held higher
# and still needs two frames and a single authorised candidate.
GATE_MATCH_MIN_FUZZY_CONFIDENCE_STANDARD=0.85
GATE_MATCH_MIN_FUZZY_CONFIDENCE_STRICT=0.90
# When the on-device reader and the cloud service independently read the same
# plate for the same event, each only has to clear its bar here. Needs
# GATE_LOCAL_OCR_MODE=active; without a local reader nothing can corroborate.
# The overnight defaults are the historical 0.90, so agreement adds nothing to
# `strict` unless a site deliberately lowers them.
GATE_MATCH_AGREEMENT_MIN_LOCAL_CONFIDENCE_STANDARD=0.50
GATE_MATCH_AGREEMENT_MIN_CLOUD_CONFIDENCE_STANDARD=0.70
GATE_MATCH_AGREEMENT_MIN_LOCAL_CONFIDENCE_STRICT=0.90
GATE_MATCH_AGREEMENT_MIN_CLOUD_CONFIDENCE_STRICT=0.90
# The on-device recogniser's own admission gate, and the floor under every
# GATE_MATCH_AGREEMENT_MIN_LOCAL_CONFIDENCE_* above: a local read below this
# never reaches the matcher at all, so it can neither decide nor corroborate.
# Set it above an agreement bar and that bar is unreachable - the effective
# local agreement bar is always max(this, the band's agreement_min_local).
# Compared against the weakest character of the read, not the mean.
GATE_LOCAL_OCR_MIN_CONFIDENCE=0.5

# Vehicle direction, shadow only (gate-controller#94). Every event ships a
# `telemetry.direction` block; nothing acts on it, and acting on it is #95.
# The signal is the slope of log(box width) over the boxes one camera alarm
# already produced - no new model, no extra decode. Set to false and every
# event ships verdict=unknown method=none instead.
GATE_DIRECTION_ENABLED=true
# The operating point, measured over 42 hand-labelled passages
# (docs/deployment.md, "Vehicle Direction (Shadow)"). Entering ran +0.010 to
# +0.098 and exiting -0.663 to -0.093 once gated, with nothing between them:
# these two sit inside that empty band. d(log width)/dt, per second.
GATE_DIRECTION_EXIT_SLOPE=-0.06
GATE_DIRECTION_ENTER_SLOPE=0.01
# The gate, and it is a safety property rather than a tuning knob: ungated,
# the same rule called an entering car an exit on a two-frame 0.8 s burst.
# Both may be raised; the controller refuses to start with either lowered.
# That refusal is the ONLY fatal setting here: any other malformed
# GATE_DIRECTION_* value falls back to the default shown, with one
# `gate_direction key=... status=rejected using=...` line in the journal.
GATE_DIRECTION_MIN_FRAMES=3
GATE_DIRECTION_MIN_SPAN_SECONDS=2.0
# Brightness below which the passage counts as night, and night direction is
# unmeasured - one dark passage in the labelled set. The test is the
# BRIGHTEST frame of the passage: one lit frame is enough for the boxes to
# have been measurable, so a passage is unmeasured only when none of its
# frames reached this. A single dark frame does not suppress it.
GATE_DIRECTION_MIN_BRIGHTNESS=0.20

GATE_CAMERA_STALE_SECONDS=60
GATE_TELEMETRY_RETENTION_DAYS=30

# One thread that measures three hops separately and writes one key=value
# journal line per cycle: the camera on the gate switch, the default gateway
# read from /proc/net/route (which crosses the powerline bridge), and the OCR
# service end to end. Only the comparison is diagnostic. No throughput test,
# ever: the uplink is ~4.5 Mbit/s and OCR uploads already saturate it.
GATE_NET_PROBE_ENABLED=true
GATE_NET_PROBE_INTERVAL_SECONDS=60
GATE_NET_PROBE_TLS_INTERVAL_SECONDS=300
GATE_NET_PROBE_TLS_HOST=api.platerecognizer.com
# The same-switch hop, and the whole point of the comparison. Set it to the
# camera's address. Unset, the hop reports `lan=unconfigured` rather than a
# guess, and the powerline bridge cannot be isolated from the rest of the LAN.
GATE_NET_PROBE_LAN_HOST=
# Packets per hop per cycle. 10 makes p95 meaningful without being a load.
GATE_NET_PROBE_PING_COUNT=10
# The fanless board idles at 66-75 C and hardware-throttles at 85 C. These two
# ceilings withhold only the expensive extras (the DNS/TCP/TLS timing and
# vcgencmd); the pings themselves keep running, because a sample lost during a
# recognition burst is the sample worth most. Below 85 C / 96 MB available
# nothing runs at all.
GATE_NET_PROBE_MAX_TEMP_C=80
GATE_NET_PROBE_MAX_LOAD=3.0

# Cloudflare controller API and Access service token. Configure all three together.
GATE_CLOUDFLARE_API_URL=
GATE_CLOUDFLARE_ACCESS_CLIENT_ID=
GATE_CLOUDFLARE_ACCESS_CLIENT_SECRET=
GATE_CONTROLLER_ID=primary
GATE_AUTHORISATION_REFRESH_SECONDS=30
GATE_AUTHORISATION_MAX_STALENESS_SECONDS=300

# A bounded in-memory ring of one-minute recognition counters, posted to
# POST /api/controller/metrics once per period on the Cloudflare client above.
# It is what fills the Recognition and Quota tiles on the app's health page,
# and it ranks below event delivery: it stands down while the gate is
# deciding and backs off instead of retrying. False constructs nothing at all.
GATE_METRICS_ENABLED=true
# 60-3600, quantised down to a whole number of five-minute buckets and never
# below one, because a bucket is what the app stores: 60 behaves as 300. One
# POST per period, aligned to the wall-clock boundary and carrying whole
# closed buckets -- at most twelve of them, so a half-hour outage backfills
# completely on reconnect.
GATE_METRICS_ROLLUP_SECONDS=300
# The Plate Recognizer allowance the month-to-date count is measured against.
# Configuration, not a measurement: change it when the plan changes.
GATE_RECOGNITION_LOOKUP_QUOTA=2500

# Event delivery uses the Cloudflare controller API above. The Worker owns R2 retention.

# Training corpus. Every frame sent to OCR is kept as a JPEG plus a JSON
# sidecar, and shipped to R2 with its index in D1 whenever nothing else wants
# the uplink. Set the directory to enable the corpus at all; the upload runs
# whenever the Cloudflare variables above are also set.
GATE_TRAINING_CORPUS_DIR=/var/lib/gate-controller/training-corpus
# The backstop for a long cloud outage, not the archive: past this the oldest
# artefacts are deleted permanently.
GATE_TRAINING_CORPUS_MAX_BYTES=1073741824
# 'off' keeps the corpus on the SD card, where it has no copy anywhere.
GATE_CORPUS_UPLOAD=on
# Nothing uploads until the uplink has been idle this long. Longer than any gap
# inside a presence session, so a vehicle at the gate never looks like quiet.
GATE_CORPUS_QUIET_SECONDS=60
GATE_CORPUS_POLL_SECONDS=300
GATE_CORPUS_BATCH=8
# 64 KB/s is about 512 kbit/s: roughly an eighth of the ~4.5 Mbit/s uplink.
GATE_CORPUS_UPLOAD_BYTES_PER_SECOND=65536

# Optional fixed local prompt files. Only these two keys can be requested remotely.
GATE_PROMPT_ARRIVAL=/opt/gate-controller/prompts/arrival.wav
GATE_PROMPT_ACCESS_DENIED=/opt/gate-controller/prompts/access-denied.wav

# Record a short clip of the gate around each event, taking the audio track
# MediaMTX already carries and copying the AAC packets without ever decoding
# anything. Every relay actuation labels its own clip, so the training set
# costs nobody any effort; a clip with no actuation is a negative, and one
# where the gate moved anyway is a remote, keypad or manual opening. There is
# no classifier: this collects data and verifies the capture works.
# Off by default. Clips are kept 30 days inside a 256 MiB cap, pruned oldest
# first, in an "audio" directory beside GATE_TRAINING_CORPUS_DIR unless
# GATE_AUDIO_CAPTURE_DIR is set. ~65 kbit/s AAC-LC, so 40 s is about 325 KB.
GATE_AUDIO_CAPTURE_ENABLED=false
GATE_AUDIO_CAPTURE_SOURCE=rtsp://127.0.0.1:8554/clear
GATE_AUDIO_CAPTURE_DIR=
GATE_AUDIO_CAPTURE_SECONDS=40
# How much of the *approach* every camera-event clip also carries. A clip that
# starts at the camera event cannot say whether the microphone heard the
# vehicle before the camera's AI did (issue #106), so one always-on child
# copies the same AAC track into five-second segments in a wrapping ring on
# tmpfs and the clip is assembled from the last 20 s of it plus the ordinary
# capture. Still nothing decoded; about 250 KB of RAM and no card wear. Set to
# 0 to run no ring child at all and leave clips exactly as they were.
GATE_AUDIO_CAPTURE_PREROLL_SECONDS=20
GATE_AUDIO_CAPTURE_RING_DIR=/dev/shm/gate-audio-ring
GATE_AUDIO_CAPTURE_MAX_CLIP_BYTES=2097152
GATE_AUDIO_CAPTURE_MAX_TOTAL_BYTES=268435456
GATE_AUDIO_CAPTURE_RETENTION_DAYS=30
GATE_AUDIO_CAPTURE_MIN_INTERVAL_SECONDS=20
# The same governor as the network probe, on the same fanless board.
GATE_AUDIO_CAPTURE_MAX_TEMP_C=80
GATE_AUDIO_CAPTURE_MAX_LOAD=3.0

# Camera API control (IR lease and 4K still) is a separate, isolated service.
# Its credentials deliberately do NOT belong in this file: the controller has no
# camera credentials and must not gain any. See deployment/gate-camera-control.env.example
# and docs/camera-control.md for /etc/gate-camera-control.env (root:root 0600).
