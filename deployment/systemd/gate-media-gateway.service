[Unit]
Description=Isolated Gate MediaMTX gateway
After=network-online.target gate-media-auth.service
Wants=network-online.target
Requires=gate-media-auth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gate-media
Group=gate-media
EnvironmentFile=/etc/gate-media-gateway.env
Environment=PYTHONPATH=/usr/local/lib/gate-media
ExecStart=/usr/bin/python3 -m gate_media_gateway /usr/local/bin/mediamtx /etc/gate-media/mediamtx.yml
Restart=always
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=256M
CPUQuota=40%
TasksMax=128
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/gate-controller -/opt/gate-controller -/opt/gate-controller-deploy -/usr/local/libexec/gate-controller -/dev/gpiomem -/dev/gpiochip0 -/dev/gpiochip1 -/dev/gpiochip2 -/dev/gpiochip3
NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/local/bin/mediamtx

[Install]
WantedBy=multi-user.target
