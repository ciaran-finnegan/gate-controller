[Unit]
Description=Isolated Gate MediaMTX gateway
After=network-online.target gate-media-auth.service
Wants=network-online.target
# Wants=, not Requires=: a failed start of the auth sidecar would otherwise
# fail this start job as a dependency failure, which Restart= never retries
# (the transcoder was stranded exactly so on 2026-10-10). Without the sidecar
# MediaMTX's external authentication fails closed, and this keeps retrying.
Wants=gate-media-auth.service
# Never give up starting. After a power cut the Pi can boot before the
# powerline link is up (NetworkManager-wait-online then fails and
# network-online.target is reached anyway); on 2026-10-10 a start limit of
# 5 in 60 s stopped the media stack for 25 minutes until someone ran
# `systemctl reset-failed` by hand. Restart= paces the retries instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=gate-media
Group=gate-media
EnvironmentFile=/etc/gate-media-gateway.env
EnvironmentFile=/var/lib/gate-media/turn.env
Environment=PYTHONPATH=/usr/local/lib/gate-media
# --wait-for-address: hold MediaMTX back (at most 60 s per attempt) until the
# ICE listener address is on this host, rather than letting it fail to bind.
ExecStart=/usr/bin/python3 -m gate_media_gateway --wait-for-address=60 /usr/local/bin/mediamtx /etc/gate-media/mediamtx.yml
Restart=always
RestartSec=10s
TimeoutStopSec=10s
MemoryMax=256M
CPUQuota=40%
TasksMax=128
UMask=0077
NoNewPrivileges=true
# /proc/<pid>/cmdline is world-readable, and gate-camera-control's carries
# the talk credential while ffmpeg is pulling the operator's microphone.
# This service has no business reading another user's processes at all, and
# with this it cannot.
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/gate-controller -/opt/gate-controller -/opt/gate-controller-deploy -/usr/local/libexec/gate-controller -/dev/gpiomem -/dev/gpiochip0 -/dev/gpiochip1 -/dev/gpiochip2 -/dev/gpiochip3
NoExecPaths=/run/gate-media /tmp /var/tmp /dev/shm

[Install]
WantedBy=multi-user.target
