[Unit]
Description=Gate MediaMTX loopback authorization sidecar
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gate-media-auth
Group=gate-media-auth
EnvironmentFile=/etc/gate-media-auth.env
# This host's loopback RTSP credential for the `talk` path, minted by
# whichever installer or updater run reached it first. Optional (`-`)
# so a host that predates it still starts: without it push-to-talk
# reports `no_credential` and everything else is unaffected. systemd
# reads it as root, which is why two services that share no group and
# no other file can both be given it.
EnvironmentFile=-/etc/gate-media/talk.env
Environment=PYTHONPATH=/usr/local/lib/gate-media
ExecStart=/usr/bin/python3 -m gate_media_auth
Restart=always
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=64M
CPUQuota=20%
TasksMax=64
UMask=0077
ReadWritePaths=/run/gate-media
NoNewPrivileges=true
# /proc/<pid>/cmdline is world-readable, and gate-camera-control's carries
# the talk credential while ffmpeg is pulling the operator's microphone.
# This service has no business reading another user's processes at all, and
# with this it cannot.
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=-/var/lib/gate-controller -/opt/gate-controller -/opt/gate-controller-deploy -/usr/local/libexec/gate-controller -/dev/gpiomem -/dev/gpiochip0 -/dev/gpiochip1 -/dev/gpiochip2 -/dev/gpiochip3
NoExecPaths=/run/gate-media /tmp /var/tmp /dev/shm

[Install]
WantedBy=multi-user.target
