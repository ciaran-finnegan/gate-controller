[Unit]
Description=CI-gated gate controller release updater
Wants=network-online.target
After=network-online.target
ConditionPathIsSymbolicLink=/opt/gate-controller-deploy/current

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/gate-controller-updater.env
ExecStart=/usr/bin/flock --nonblock /run/gate-controller-updater/update.lock /usr/bin/python3 /usr/local/libexec/gate-controller/gate-controller-updater.py
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
UMask=0077
RuntimeDirectory=gate-controller-updater
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# The release tree, the lock, and the helper this unit executes. The rest are
# the managed components the updater republishes from each active release
# (deployment.md, "What An Automatic Release Covers"): without them
# ProtectSystem=strict makes every publication fail on a read-only path. This
# is not a widening of what the updater can ultimately do -- it already writes
# the code the controller runs as root and the helper systemd executes here --
# but it is deliberately enumerated rather than granted wholesale, and a "-"
# path that does not exist on this host is simply skipped.
ReadWritePaths=/opt/gate-controller-deploy /run/gate-controller-updater -/usr/local/libexec/gate-controller -/usr/local/lib/gate-camera-control -/usr/local/lib/gate-media -/etc/gate-media -/etc/systemd/system -/etc/tmpfiles.d -/run/gate-camera
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
