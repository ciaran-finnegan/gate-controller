[Unit]
Description=Isolated gate camera control service (IR lease and 4K still)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=gate-camera-control
Group=gate-camera-control
EnvironmentFile=/etc/gate-camera-control.env
Environment=PYTHONPATH=/usr/local/lib/gate-camera-control
ExecStart=/usr/bin/python3 -m gate_camera_control
Restart=always
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=64M
CPUQuota=20%
TasksMax=64
UMask=0077
ReadWritePaths=/run/gate-camera
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# The installer adds the camera's exact /32 in
# gate-camera-control.service.d/10-camera-address.conf; without that drop-in the
# service can reach nothing but loopback.
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/var/lib/gate-controller -/opt/gate-controller -/opt/gate-controller-deploy -/usr/local/libexec/gate-controller -/etc/gate-media-gateway.env -/etc/gate-media-auth.env -/etc/gate-media-turn.env -/var/lib/gate-media -/dev/gpiomem -/dev/gpiochip0 -/dev/gpiochip1 -/dev/gpiochip2 -/dev/gpiochip3
NoExecPaths=/run/gate-camera /tmp /var/tmp /dev/shm

[Install]
WantedBy=multi-user.target
