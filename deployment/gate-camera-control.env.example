# Template for /etc/gate-camera-control.env (root:root 0600).
#
# These are the ONLY camera API credentials on the Pi. They must not be copied
# into /etc/gate-media-gateway.env (its key set is pinned and holds the RTSP
# secret) and the controller must never gain access to this file.
#
# Install with:
#   sudo install -o root -g root -m 0600 /dev/null /etc/gate-camera-control.env
#   sudoedit /etc/gate-camera-control.env
#
# Every line must be KEY=value with no spaces, no quotes, no comments, and the
# file must end with a newline: gate_media_config.parse_trusted_environment
# rejects anything else.

# Required. Exactly one reachable IP address; hostnames are rejected because the
# systemd drop-in pins the service's egress to this address /32.
GATE_CAMERA_HOST=192.168.0.54
GATE_CAMERA_USERNAME=replace-me
GATE_CAMERA_PASSWORD=replace-me

# Optional. Shown with their defaults.
# The state IR always returns to when a lease expires or the service restarts.
# Off is the deployed default since 2026-09-06: IR on re-creates the near-post
# blaze that degrades plate recognition.
GATE_CAMERA_IR_DEFAULT=Off
# Lease length used when a request omits lease_minutes (1-60).
GATE_CAMERA_IR_LEASE_DEFAULT_MINUTES=10
# Longest lease any caller may request (1-60).
GATE_CAMERA_IR_LEASE_MAX_MINUTES=60

# Push-to-talk over the camera's Baichuan port (TCP 9000). Off by default: with
# it off the service never opens that port. Turn it on only on a camera with a
# speaker (the RLC-811A has one; the RLC-810A does not), then follow
# docs/talkback.md for the supervised acceptance test.
GATE_CAMERA_TALK_ENABLED=false
# Hard limit on one talk session (5-60). The session is killed at this many
# seconds after arming, however the browser behaves.
GATE_CAMERA_TALK_MAX_SECONDS=30
